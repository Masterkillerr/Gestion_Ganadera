# ────────────────────────────────────────────────────────────
#  Elastic Beanstalk Environment Properties
# ────────────────────────────────────────────────────────────
#  This file declares the environment variables that the
#  Spring Boot backend reads at runtime.  Secrets (JWT,
#  reCAPTCHA, DB password, SMTP) are left empty here and
#  MUST be set externally:
#
#    1. Via GitHub Actions secrets  (recommended — see deploy.yml)
#    2. Via the EB Console          (Configuration → Software → Environment properties)
#    3. Via the AWS CLI             (eb setenv / update-environment)
#
#  If a variable is left empty, the application falls back to
#  the default hard-coded in application.properties.
# ────────────────────────────────────────────────────────────
#  NOTE: All env vars MUST be under a single namespace block.
#  EB ignores subsequent blocks with the same namespace.
# ────────────────────────────────────────────────────────────

option_settings:
  aws:elasticbeanstalk:application:environment:
    DB_URL: jdbc:postgresql://localhost:5432/gestion_ganadera
    DB_USERNAME: postgres
    DB_PASSWORD: ""
    DB_DDL_AUTO: none
    DB_SHOW_SQL: "false"
    FLYWAY_ENABLED: "true"
    JWT_SECRET: ""
    JWT_EXPIRATION: "604800000"
    CORS_ALLOWED_ORIGINS: "https://d3gw8tv95pui9q.cloudfront.net"
    RECAPTCHA_SECRET: ""
    MAIL_HOST: email-smtp.us-east-2.amazonaws.com
    MAIL_PORT: "587"
    MAIL_USERNAME: ""
    MAIL_PASSWORD: ""
    MAIL_FROM: ""
    LOG_LEVEL: INFO
    SECURITY_LOG_LEVEL: INFO
    SERVER_PORT: "8080"
    UPLOAD_DIR: /var/app/current/uploads
