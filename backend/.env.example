# ===========================================
# Gestion Ganadera Backend - Environment Variables
# Copy this file to .env and fill in your values
# ===========================================

# Server
SERVER_PORT=8080

# Database (Supabase)
DB_URL=jdbc:postgresql://your-supabase-host.pooler.supabase.com:5432/postgres
DB_USERNAME=postgres.your-project-ref
DB_PASSWORD=your_db_password_here
DB_DDL_AUTO=none
DB_SHOW_SQL=true

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-netlify-app.netlify.app

# JWT
JWT_SECRET=tOBKV78IsdH5cmmF/E2MO7F+4HEKkfmWOz9O7WYpWsJAcY9Bg7RzotfPQh1K9aFyWRhz02Yea9xVi0h+5MAiwA==
JWT_EXPIRATION=604800000

# reCAPTCHA
RECAPTCHA_SECRET=your_recaptcha_secret_here

# File Upload
UPLOAD_DIR=../uploads/

# Logging
LOG_LEVEL=DEBUG
SECURITY_LOG_LEVEL=DEBUG
