[TEMPLATE]
# ===========================================
# Gestion Ganadera Backend - Environment Variables
# Copy this file to .env and fill in your values
# ===========================================

# Server
SERVER_PORT=8080

# Database (AWS RDS)
DB_URL=jdbc:postgresql://your-rds-endpoint.region.rds.amazonaws.com:5432/your_db_name
DB_USERNAME=postgres
DB_PASSWORD=your_secure_password_here
DB_DDL_AUTO=none
DB_SHOW_SQL=true

# CORS
# For development: http://localhost:5173,http://localhost:5174,...
# For production: your CloudFront domain only
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-cloudfront-domain.cloudfront.net

# JWT
# Generate with: openssl rand -base64 44
JWT_SECRET=your_secure_jwt_secret_min_32_chars_here_generate_new
JWT_EXPIRATION=604800000

# reCAPTCHA
# Get from https://www.google.com/recaptcha/admin
RECAPTCHA_SECRET=your_recaptcha_secret_here

# File Upload
UPLOAD_DIR=../uploads/

# Logging
LOG_LEVEL=INFO
SECURITY_LOG_LEVEL=INFO
